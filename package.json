{
  "name": "uji",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:cli": "pnpm --dir packages/tui build:binary",
    "dev": "turbo dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "models:check": "pnpm --dir packages/ai models:check",
    "models:generate": "pnpm --dir packages/ai models:generate",
    "models:opencode:snapshot": "pnpm --dir packages/ai models:opencode:snapshot",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
