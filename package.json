    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
