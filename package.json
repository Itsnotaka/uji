{
  "name": "uji",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cli": "pnpm --dir packages/tui build:binary",
    "dev": "pnpm --dir packages/demo/desktop dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "oxfmt --check",
