{
  "name": "@uji-ai/tui",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:binary": "rm -rf ../../bin && mkdir -p ../../bin && bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv src/binary.ts --outfile ../../bin/uji && codesign --force --sign - ../../bin/uji",
    "clean": "rm -rf node_modules .turbo ../../bin",
    "dev": "UJI_TUI_RENDER_LOG=1 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/keymap": "^0.5.9",
    "@uji-ai/ai": "workspace:*",
    "@uji-ai/core": "workspace:*",
    "@uji-ai/plugin": "workspace:*",
    "@uji-ai/schema": "workspace:*",
    "beautiful-mermaid": "1.1.3",
    "diff": "9.0.0",
    "fuzzysort": "3.1.0",
    "open": "^11.0.1",
    "semver": "7.8.5",
    "shiki": "4.4.3",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/semver": "7.7.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
