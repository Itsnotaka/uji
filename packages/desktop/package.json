{
  "name": "@uji-ai/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "The Uji desktop app: an Electron host over @uji-ai/core's SDK.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist out",
    "build": "electron-vite build && node scripts/check-startup-bundle.mjs",
    "dev": "install-electron && electron-vite dev",
    "package": "pnpm build && electron-builder --dir --config electron-builder.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@pierre/diffs": "1.3.1",
    "@pierre/trees": "1.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-virtual": "3.14.10",
    "@uji-ai/ai": "workspace:*",
    "@uji-ai/core": "workspace:*",
    "@uji-ai/plugin": "workspace:*",
    "@uji-ai/schema": "workspace:*",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-2-stroke-1.5@^1.1.315",
    "diff": "9.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grab": "^0.2.0",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.1.1",
    "electron-builder": "26.15.2",
    "electron-vite": "file:../../vendor/electron-vite-6.0.0-beta.1-608461c.tgz",
    "typescript": "^7.0.2",
    "vite": "7.1.4"
  }
}
