{
  "name": "@june/ui",
  "private": true,
  "description": "Raw-source Base UI primitives styled with StyleX and themed by consumers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./style": "./src/style.ts",
    "./platform-tokens.css": "./src/platform-tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.stylex": "./src/tokens.stylex.ts",
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "check:tokens": "node scripts/sync-platform-tokens.mjs --check",
    "sync:tokens": "node scripts/sync-platform-tokens.mjs",
    "typecheck": "pnpm check:tokens && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@stylexjs/stylex": "0.19.0",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-1-stroke-1.5@^1.1.306",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
